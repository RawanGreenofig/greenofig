# Copy this to .env.local and fill in real values.
# .env.local is gitignored.

# ── Supabase (required for auth + DB) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Server-only ───────────────────────────────────────────────────────
# Used by API routes that need to bypass RLS (audit log writes,
# webhook handlers, scanner / AI endpoints reading api_keys, etc.).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Stripe (required for store + bookings) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Google Gemini (scanner + AI chat + research desk) ─────────────────
# Get your key from https://aistudio.google.com → "Get API Key"
# (free tier: 15 req/min, 1500/day; starts with "AIza...")
GOOGLE_GEMINI_API_KEY=
# Optional model overrides — see src/lib/gemini.ts for defaults
GEMINI_MODEL=
GEMINI_RESEARCH_MODEL=

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OpenClaw integration ──────────────────────────────────────────────
# Dr. Rawan's WhatsApp/Telegram AI assistant calls
# /api/openclaw/webhook with this secret in the
# x-openclaw-secret header. Generate a 32+ char random
# string at https://randomstring.net.
OPENCLAW_WEBHOOK_SECRET=generate_a_random_32_char_string
