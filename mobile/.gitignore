# Capacitor + Android build artifacts. The android/ folder is
# regenerated by `npx cap add android` (locally and in CI) so we
# don't commit its thousands of generated files.
node_modules
android/
ios/
.DS_Store

# Build outputs
*.apk
*.aab
*.idsig
build/

# Keystore must NEVER be committed — it lives in GitHub Secrets
# (as base64) for CI and on the dev's machine for local builds.
*.jks
*.keystore
keystore.properties
