# Capacitor + Android build artifacts. The android/ folder is
# regenerated by `npx cap add android` (locally and in CI) so we
# don't commit its thousands of generated files.
node_modules
android/
ios/
.DS_Store

# Build outputs
*.apk
*.aab
*.idsig
build/

# Keystore must NEVER be committed — it lives in GitHub Secrets
# (as base64) for CI and on the dev's machine for local builds.
*.jks
*.keystore
keystore.properties

# Firebase project descriptor — identifies the FCM Android project.
# Not itself a secret (the keys inside are public client identifiers)
# but we still source it from a GitHub Secret in CI so the same
# google-services.json file lives in one place. Locals can drop a
# copy at mobile/android/app/google-services.json if they want to
# test push from their own machine.
google-services.json
